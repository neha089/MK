# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ─── Session secret (custom JWT auth — no NextAuth) ───────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET="your-secret-here"
# Legacy alias still accepted; SESSION_SECRET takes precedence when both are set
# NEXTAUTH_SECRET="your-secret-here"

# ─── Push notifications (optional — ntfy.sh topic for new enquiry alerts) ────
# NTFY_TOPIC="your-ntfy-topic"

# ─── Cloudinary (optional — required only for product image upload UI) ────────
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
